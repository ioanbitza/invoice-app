{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git tag *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npx *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(printenv)",
      "Bash(env)"
    ]
  }
}
