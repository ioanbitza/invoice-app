[{"id":"CON-1","class":"contract","severity":"advisory","file":"src/ui/views/customer-detail.js","line":131,"what_breaks":"The S12 commit says it fixes F-35, but two views still do not follow the view shape in ADR-003. customer-detail.js still receives the whole context, including the mutable state object. order-list.js (S13) was not touched for F-35: it still takes the context, writes state.searchOrders itself, and keeps per-control listeners. F-35 was accepted, so it is still half closed.","requirement":"none","evidence":"ADR-003:35 'A view has the shape `render(container, viewModel, actions)` and one delegated listener per container (JS-11).' customer-detail.js:131 'export function renderCustomerDetail(container, context) {', :132 'const { route, state, commit, openDialog, showBanner, deps, locale } = context;'. order-list.js:134 'export function renderOrderList(container, context) {', :126 'state.searchOrders = input.value;', :125 'input.addEventListener('input', ...)', :77 'empty.querySelector('button').addEventListener('click', onClear);'. main.js:72 still maps 'customer: renderCustomerDetail' and 'orders: renderOrderList' straight to the context call at main.js:241. Commit c9cc2ba 'S12: fix F-35' changed only the listeners, and no commit in scope touches S13 for F-35.","proven":true},
